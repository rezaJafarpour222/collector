# Time range — Jalali (Persian) calendar, YYYY/MM/DD
START_DATE=1405/08/26
END_DATE=1405/08/27

# S3-compatible object storage
S3_ENDPOINT=https://s3.ir-central1.arvanstorage.ir
S3_REGION=us-east-1
S3_BUCKET=aqms
S3_ACCESS_KEY_ID=8d9c22f2-9901-4169-8f97-2eb4485cddd9
S3_SECRET_ACCESS_KEY=2decbc2ec34990dc1d1f3a130d860bafc641505ceb9c46e9cc489a1b1efc3ad0
S3_KEY_PREFIX=raw
S3_PATH_STYLE=true                                 

# Fetch tuning
FETCH_CONCURRENCY=4
FETCH_DELAY_MS=1000
FETCH_MAX_RETRIES=1                                 # 2 attempts total
FETCH_TIMEOUT_SECS=30

# Upload tuning
UPLOAD_MAX_RETRIES=3                                # 4 attempts total

# Debug: copy temp files to ./aqms-out/ before exiting
KEEP_TEMP=false
